{
  "name": "prompt-line",
  "version": "0.40.0",
  "description": "Prompt Line is a macOS app developed to improve the prompt input experience in the terminal for CLI-based AI coding agents such as Claude Code, OpenAI Codex CLI, and Aider.",
  "main": "dist/main.js",
  "bin": {
    "prompt-line-plugin": "scripts/plugin-cli.js"
  },
  "scripts": {
    "start": "LOG_LEVEL=debug pnpm run compile && LOG_LEVEL=debug electron .",
    "compile": "node scripts/generate-git-info.js && node node_modules/electron/install.js && tsc && pnpm run build:renderer && cd native && make install && cp -r ../src/native-tools ../dist/",
    "build:renderer": "vite build && cp src/renderer/input.html dist/renderer/input.html",
    "typecheck": "node scripts/generate-git-info.js && tsc --noEmit",
    "build": "pnpm run compile && node scripts/build.js",
    "install-app": "pnpm run setup-codesign && pnpm run compile && node scripts/install.js",
    "isolated": "node scripts/isolated-instance.js",
    "clean": "rm -rf dist/mac* dist/*.dmg dist/*.zip dist/*.blockmap",
    "clean:cache": "rm -rf node_modules/.cache ~/Library/Caches/electron-builder ~/Library/Caches/electron",
    "clean:full": "pnpm run clean && pnpm run clean:cache && rm -rf dist/",
    "release": "echo 'Releases are automated via GitHub Actions with Release Please on push to main branch'",
    "test": "node scripts/generate-git-info.js && vitest run",
    "test:watch": "node scripts/generate-git-info.js && vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "lint": "eslint 'src/**/*.{js,ts}' 'tests/**/*.{js,ts}'",
    "lint:fix": "eslint 'src/**/*.{js,ts}' 'tests/**/*.{js,ts}' --fix",
    "lint:dupl": "jscpd ./src",
    "test:mutation": "stryker run",
    "pre-push": "pnpm run lint && pnpm run typecheck && pnpm test",
    "prepare": "husky",
    "setup-codesign": "bash scripts/setup-codesign.sh",
    "reset-accessibility": "tccutil reset Accessibility com.electron.prompt-line && echo '✅ Accessibility permissions for Prompt Line have been reset'",
    "plugin": "pnpm exec ts-node scripts/plugin.ts",
    "plugin:install": "pnpm exec ts-node scripts/plugin.ts install",
    "plugin:help": "pnpm exec ts-node scripts/plugin.ts help",
    "generate:settings-example": "pnpm exec ts-node scripts/generate-settings-example.ts",
    "migrate-settings": "pnpm exec ts-node scripts/migrate-settings.ts"
  },
  "keywords": [
    "paste",
    "quick",
    "text",
    "productivity"
  ],
  "author": "nkmr-jp",
  "license": "MIT",
  "engines": {
    "node": ">=20.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "electron": "^39.8.10",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jscpd": "^4.3.0",
    "jsdom": "^27.4.0",
    "knip": "^6.34.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.4",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.electron.prompt-line",
    "productName": "Prompt Line",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "!dist/mac",
      "!dist/mac-arm64",
      "!dist/*.dmg",
      "!dist/*.zip",
      "!dist/*.blockmap",
      "!dist/builder-*"
    ],
    "asarUnpack": [
      "dist/native-tools/**/*"
    ],
    "afterPack": "scripts/afterPack.js",
    "afterSign": "scripts/afterSign.js",
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "assets/Prompt-Line.icns",
      "artifactName": "Prompt-Line-${version}-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "This app needs to control other applications to paste text.",
        "NSAccessibilityUsageDescription": "This app needs accessibility access to paste text into other applications."
      },
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vscode/codicons": "^0.0.44",
    "chokidar": "^5.0.0",
    "glob": "^13.0.6",
    "jq-web": "^0.6.2",
    "js-yaml": "^4.3.2",
    "tailwindcss": "^4.3.3"
  },
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485"
}
